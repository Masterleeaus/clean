{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanzero.local/.titan/schemas/object-metadata.schema.json",
  "title": "Titan Agent OS Object Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "kind", "schema_version", "version", "status", "owner", "verification", "lifecycle"],
  "properties": {
    "id": {"type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "kind": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "active", "dormant", "deprecated", "superseded", "retired", "rejected", "quarantined"]
    },
    "owner": {
      "type": "object",
      "required": ["authority"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "team": {"type": ["string", "null"]},
        "maintainer": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "basis": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["last_verified", "source_commit", "evidence"],
      "properties": {
        "last_verified": {"type": ["string", "null"], "format": "date"},
        "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
        "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "used_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lifecycle": {
      "type": "object",
      "required": ["created", "updated"],
      "properties": {
        "created": {"type": "string", "format": "date"},
        "updated": {"type": "string", "format": "date"},
        "deprecated": {"type": ["string", "null"], "format": "date"},
        "superseded_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "properties": {
        "executions": {"type": "integer", "minimum": 0},
        "successes": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
