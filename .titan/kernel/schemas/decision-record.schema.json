{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanzero.local/.titan/schemas/decision-record.schema.json",
  "title": "Titan Agent OS Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "context", "options", "rationale", "consequences", "authorities", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^decision:[a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 3},
    "status": {"type": "string", "enum": ["proposed", "accepted", "rejected", "superseded", "archived"]},
    "context": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "advantages": {"type": "array", "items": {"type": "string"}},
          "disadvantages": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "selected_option": {"type": ["string", "null"]},
    "rationale": {"type": "string", "minLength": 1},
    "consequences": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "related_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "related_policies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "related_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "authorities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "approvals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "decided_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
