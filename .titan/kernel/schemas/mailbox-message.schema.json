{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanzero.local/.titan/schemas/mailbox-message.schema.json",
  "title": "Titan Agent OS Mailbox Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "message_type", "sender", "recipients", "created_at", "priority", "event_id", "body", "delivery"],
  "properties": {
    "id": {"type": "string", "minLength": 8},
    "message_type": {"type": "string", "enum": ["task-assignment", "escalation", "feedback", "review-request", "decision-request", "broadcast", "status-update"]},
    "sender": {"type": "string", "minLength": 1},
    "recipients": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "priority": {"type": "string", "enum": ["low", "normal", "high", "critical"]},
    "event_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "correlation_id": {"type": ["string", "null"]},
    "body": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "details": {"type": ["string", "null"]},
        "error_trace": {"type": ["string", "null"]},
        "attempted_fixes": {"type": "array", "items": {"type": "string"}},
        "suggested_resolution": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["status", "attempts"],
      "properties": {
        "status": {"type": "string", "enum": ["queued", "delivered", "acknowledged", "failed", "expired"]},
        "attempts": {"type": "integer", "minimum": 0},
        "acknowledged_at": {"type": ["string", "null"], "format": "date-time"},
        "cursor": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
