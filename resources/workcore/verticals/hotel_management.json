{
  "key": "hotel_management",
  "label": "Hotel and Motel Management",
  "version": "1.0.0",
  "type": "vertical",
  "extends": [
    "accommodation_core"
  ],
  "capabilities": [],
  "features": {
    "hotel.front_desk": true,
    "hotel.room_inventory": true,
    "hotel.rates": true,
    "hotel.folios": true,
    "hotel.housekeeping_board": true,
    "hotel.night_audit": true
  },
  "terminology": {
    "entity.customer.singular": "Guest",
    "entity.customer.plural": "Guests",
    "entity.premises.singular": "Hotel",
    "entity.premises.plural": "Hotels",
    "entity.work_order.singular": "Operational task",
    "entity.work_order.plural": "Operational tasks",
    "entity.worker.singular": "Staff member",
    "entity.worker.plural": "Staff"
  },
  "metadata": {},
  "setup": {
    "default_business_lines": [
      {
        "key": "front_office",
        "name": "Front Office"
      },
      {
        "key": "housekeeping",
        "name": "Housekeeping"
      },
      {
        "key": "hotel_maintenance",
        "name": "Hotel Maintenance"
      }
    ],
    "questions": [
      {
        "key": "hotel.property_type",
        "section": "vertical_details",
        "prompt": "What type of accommodation property is being configured?",
        "type": "select",
        "required": true,
        "options": [
          "hotel",
          "motel",
          "serviced_apartments",
          "hostel",
          "resort"
        ]
      },
      {
        "key": "hotel.room_count",
        "section": "vertical_details",
        "prompt": "How many rooms or units should be prepared?",
        "type": "integer",
        "required": true
      },
      {
        "key": "hotel.departments",
        "section": "vertical_details",
        "prompt": "Which hotel departments should be created?",
        "type": "multiselect",
        "required": true,
        "options": [
          "front_office",
          "housekeeping",
          "maintenance",
          "food_beverage",
          "security",
          "sales",
          "finance"
        ]
      }
    ],
    "documents": [
      "guest_welcome_guide",
      "cleaning_checklist",
      "maintenance_report",
      "emergency_procedure",
      "staff_induction"
    ]
  }
}
