{
  "version": "2.0.0",
  "system": "Titan Agent Operating System",
  "description": "AI Agent runtime with lifecycle management, communication, and observability",
  "production_ready": true,
  "created_at": "2026-07-30T00:00:00Z",

  "runtime": {
    "registry_path": ".titan/registry",
    "storage_path": ".titan/storage",
    "logs_path": ".titan/logs",
    "temp_path": ".titan/temp",
    "config_path": ".titan/config"
  },

  "agent_defaults": {
    "context": {
      "max_tokens": 200000,
      "reserve_tokens": 10000,
      "model": "claude-opus-5"
    },
    "resources": {
      "memory_mb": 1024,
      "cpu_shares": 1.0,
      "timeout_seconds": 3600,
      "max_concurrent_tools": 10
    },
    "communication": {
      "timeout_ms": 30000,
      "retry_attempts": 3,
      "backoff_strategy": "exponential"
    }
  },

  "agent_archetypes": {
    "code-agent": {
      "description": "Code analysis, generation, and refactoring",
      "capabilities": [
        "tool:file:read",
        "tool:file:write",
        "tool:git:read",
        "tool:git:push",
        "tool:shell:execute",
        "agent:call",
        "storage:read",
        "storage:write"
      ],
      "resources": {
        "memory_mb": 2048,
        "cpu_shares": 2.0
      }
    },
    "research-agent": {
      "description": "Information gathering and synthesis",
      "capabilities": [
        "tool:external:http",
        "agent:call",
        "storage:read",
        "storage:write"
      ],
      "resources": {
        "memory_mb": 1024,
        "cpu_shares": 1.0
      }
    },
    "planning-agent": {
      "description": "Workflow orchestration and planning",
      "capabilities": [
        "agent:call",
        "agent:spawn",
        "agent:monitor",
        "storage:read",
        "storage:write"
      ],
      "resources": {
        "memory_mb": 1024,
        "cpu_shares": 1.5
      }
    },
    "execution-agent": {
      "description": "Task automation and tool invocation",
      "capabilities": [
        "tool:*",
        "agent:call",
        "storage:read",
        "storage:write"
      ],
      "resources": {
        "memory_mb": 1536,
        "cpu_shares": 2.0
      }
    },
    "monitoring-agent": {
      "description": "Health monitoring and alerting",
      "capabilities": [
        "agent:monitor",
        "storage:read",
        "tool:external:http"
      ],
      "resources": {
        "memory_mb": 512,
        "cpu_shares": 0.5
      }
    }
  },

  "communication": {
    "protocol": "agent-communication-protocol/1.0",
    "transport": {
      "type": "tcp",
      "port": 9000,
      "tls": true,
      "tls_cert": ".titan/certs/server.crt",
      "tls_key": ".titan/certs/server.key"
    },
    "message_queue": {
      "enabled": true,
      "backend": "in-memory",
      "max_queue_size": 10000,
      "persistence": {
        "enabled": true,
        "path": ".titan/queue"
      }
    },
    "pub_sub": {
      "enabled": true,
      "message_retention_ms": 3600000,
      "max_subscribers": 1000
    },
    "rpc": {
      "timeout_ms": 30000,
      "retry_attempts": 3,
      "backoff_initial_ms": 100,
      "backoff_max_ms": 10000
    }
  },

  "security": {
    "authentication": {
      "enabled": true,
      "method": "mtls",
      "certificate_verification": true,
      "certificate_path": ".titan/certs"
    },
    "authorization": {
      "enabled": true,
      "model": "capability-based",
      "policy_path": ".titan/config/policies.json"
    },
    "secrets": {
      "enabled": true,
      "encryption": "aes-256-gcm",
      "storage_path": ".titan/secrets",
      "rotation_interval_days": 30
    },
    "audit": {
      "enabled": true,
      "log_path": ".titan/logs/audit",
      "retention_days": 90,
      "immutable": true
    },
    "sandboxing": {
      "enabled": true,
      "resources": {
        "memory_limit_mb": 4096,
        "cpu_limit": 4.0,
        "timeout_seconds": 3600
      }
    }
  },

  "observability": {
    "logging": {
      "enabled": true,
      "level": "info",
      "format": "json",
      "output": [
        {
          "type": "file",
          "path": ".titan/logs/runtime.log",
          "rotation": "daily",
          "retention_days": 30
        }
      ]
    },
    "tracing": {
      "enabled": true,
      "backend": "jaeger",
      "sample_rate": 1.0,
      "endpoint": "http://localhost:6831"
    },
    "metrics": {
      "enabled": true,
      "backend": "prometheus",
      "port": 9090,
      "interval_ms": 10000
    },
    "dashboards": {
      "enabled": true,
      "grafana_url": "http://localhost:3000"
    }
  },

  "storage": {
    "state_store": {
      "backend": "file",
      "path": ".titan/storage/state",
      "ttl_default_seconds": 2592000
    },
    "checkpoint_store": {
      "backend": "file",
      "path": ".titan/storage/checkpoints",
      "retention_days": 7
    },
    "knowledge_graph": {
      "enabled": true,
      "backend": "in-memory",
      "persistence": {
        "enabled": true,
        "path": ".titan/storage/knowledge"
      }
    }
  },

  "resource_management": {
    "cpu_allocator": {
      "total_cores": 4,
      "min_per_agent": 0.25,
      "max_per_agent": 2.0
    },
    "memory_allocator": {
      "total_mb": 8192,
      "min_per_agent_mb": 256,
      "max_per_agent_mb": 2048,
      "gc_threshold_mb": 6144
    },
    "context_allocator": {
      "total_tokens": 200000,
      "min_per_agent": 50000,
      "max_per_agent": 100000,
      "reserve_for_system": 10000
    }
  },

  "plugins": {
    "enabled": true,
    "plugin_registry": ".titan/plugins/registry.json",
    "plugin_path": ".titan/plugins",
    "auto_load": true,
    "built_in": [
      "tool-registry",
      "event-bus",
      "state-store",
      "resource-manager",
      "permission-manager",
      "health-monitor"
    ]
  },

  "development": {
    "debug": false,
    "verbose_logging": false,
    "profiling_enabled": false,
    "test_mode": false,
    "mock_external_services": false
  },

  "features": {
    "agent_clustering": true,
    "auto_scaling": true,
    "fault_recovery": true,
    "canary_deployment": true,
    "health_checks": true,
    "rate_limiting": true,
    "circuit_breaker": true,
    "load_balancing": true
  },

  "deployment": {
    "environments": {
      "local": {
        "host": "localhost",
        "debug": true,
        "persistence": false
      },
      "staging": {
        "host": "staging.titan.internal",
        "debug": false,
        "persistence": true
      },
      "production": {
        "host": "titan.production",
        "debug": false,
        "persistence": true,
        "replicas": 3,
        "auto_recovery": true
      }
    }
  },

  "integration": {
    "github": {
      "enabled": true,
      "token_env": "GITHUB_TOKEN",
      "webhook_path": "/webhooks/github"
    },
    "slack": {
      "enabled": true,
      "token_env": "SLACK_TOKEN",
      "webhook_path": "/webhooks/slack"
    },
    "monitoring_backends": {
      "prometheus": true,
      "datadog": false,
      "cloudwatch": false,
      "newrelic": false
    }
  }
}
