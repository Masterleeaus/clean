{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recovery Plan Schema",
  "description": "Detailed recovery plan for branch recovery",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique recovery plan ID (e.g., recovery-001)"
    },
    "source_branch": {
      "type": "string",
      "description": "Original feature branch"
    },
    "recovery_branch": {
      "type": "string",
      "description": "New recovery branch name"
    },
    "base_branch": {
      "type": "string",
      "description": "Base to create recovery from (typically main)"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "completed", "failed", "merged"]
    },
    "plan": {
      "type": "object",
      "properties": {
        "step_1_create_recovery": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "description": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "step_2_cherry_pick": {
          "type": "object",
          "properties": {
            "commits": {
              "type": "array",
              "items": { "type": "string" },
              "description": "List of commit hashes to replay"
            },
            "expected_conflicts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": { "type": "string" },
                  "type": { "type": "string" },
                  "resolution": { "type": "string" }
                }
              }
            },
            "status": { "type": "string" }
          }
        },
        "step_3_compile": {
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "items": { "type": "string" }
            },
            "expected_duration": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "step_4_tests": {
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "items": { "type": "string" }
            },
            "coverage_target": { "type": "number" },
            "status": { "type": "string" }
          }
        },
        "step_5_audit": {
          "type": "object",
          "properties": {
            "checks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "status": { "type": "string" }
          }
        }
      }
    },
    "conflicts_resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "conflict_type": { "type": "string" },
          "resolution": { "type": "string" },
          "resolved_by": { "type": "string" }
        }
      }
    },
    "test_results": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "coverage": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "audit_results": {
      "type": "object",
      "properties": {
        "no_duplicate_classes": { "type": "boolean" },
        "no_orphaned_routes": { "type": "boolean" },
        "di_valid": { "type": "boolean" },
        "namespace_collisions": { "type": "boolean" },
        "all_imports_valid": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "merge_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "regression_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "conflict_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "overall_assessment": { "type": "string" }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["id", "source_branch", "recovery_branch", "status", "plan"]
}
