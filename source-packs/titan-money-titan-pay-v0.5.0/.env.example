APP_NAME="Titan Zero"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DEMO_MODE=false
APP_URL=http://localhost
APP_TIMEZONE=Australia/Sydney
APP_LOCALE=en_AU
APP_FALLBACK_LOCALE=en_AU
APP_FAKER_LOCALE=en_AU

# Upgrade-only bootstrap: an existing matching user is promoted once by the v0.4 migration.
# New installations should use: php artisan platform:admin user@example.com
ADMIN_EMAIL=

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meetup
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=



# Titan Money and Titan Pay
TITAN_MONEY_DEFAULT_CURRENCY=AUD
TITAN_MONEY_DEFAULT_TIMEZONE=Australia/Sydney
TITAN_MONEY_DEFAULT_TAX_RATE_BPS=1000
TITAN_MONEY_DEFAULT_TERMS_DAYS=14
TITAN_MONEY_INVOICE_PREFIX=INV
TITAN_MONEY_PRIVATE_DISK=local
TITANPAY_PRIVATE_DISK=local
TITANPAY_SESSION_TTL_MINUTES=1440
TITANPAY_STRIPE_TOLERANCE_SECONDS=300
TITANPAY_MAX_EVIDENCE_KB=5120

# Store provider secrets in Titan Vault in production. Environment values are local-development fallbacks only.
TITANPAY_STRIPE_SECRET=
TITANPAY_STRIPE_PUBLISHABLE_KEY=
TITANPAY_STRIPE_WEBHOOK_SECRET=
TITANPAY_PAYPAL_CLIENT_ID=
TITANPAY_PAYPAL_CLIENT_SECRET=
TITANPAY_PAYPAL_WEBHOOK_ID=

# Titan Money agent automation
TITAN_MONEY_SEND_ON_ISSUE=true
TITAN_MONEY_AGENT_SCHEDULE_MINUTES=5
TITAN_MONEY_OUTBOX_BATCH_SIZE=200
TITAN_MONEY_DELIVERY_BATCH_SIZE=100

# Titan Pay customer checkout
TITANPAY_ALLOW_CUSTOMER_STRIPE=false

# Titan Channels concrete delivery transports
TITAN_CHANNELS_RECEIPT_SECRET=
TITAN_CHANNELS_RECEIPT_TOLERANCE_SECONDS=300
TITAN_CHANNELS_QUIET_HOURS_START=20:00
TITAN_CHANNELS_QUIET_HOURS_END=08:00
TITAN_CHANNELS_SMS_PROVIDER=webhook
TITAN_CHANNELS_SMS_WEBHOOK_URL=
TITAN_CHANNELS_SMS_WEBHOOK_TOKEN=
TITAN_CHANNELS_VOICE_PROVIDER=webhook
TITAN_CHANNELS_VOICE_WEBHOOK_URL=
TITAN_CHANNELS_VOICE_WEBHOOK_TOKEN=
TITAN_CHANNELS_WHATSAPP_PROVIDER=webhook
TITAN_CHANNELS_WHATSAPP_WEBHOOK_URL=
TITAN_CHANNELS_WHATSAPP_WEBHOOK_TOKEN=
TITANPAY_PAYID_VALUE=
TITANPAY_PAYID_ACCOUNT_NAME=
TITANPAY_BANK_BSB=
TITANPAY_BANK_ACCOUNT_NUMBER=
TITANPAY_BANK_ACCOUNT_NAME=
TITANPAY_QR_PYTHON_BINARY=python3
TITANPAY_QR_TIMEOUT_SECONDS=5
